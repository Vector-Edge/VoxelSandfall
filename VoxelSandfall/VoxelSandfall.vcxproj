  <!-- Copy the HLSL sources next to the executable; they are compiled at runtime (F9 hot-reloads them). -->
  <Target Name="CopyShaders" AfterTargets="Build">
    <ItemGroup>
      <ShaderSource Include="$(ProjectDir)shaders\*.hlsl;$(ProjectDir)shaders\*.hlsli" />
    </ItemGroup>
    <Copy SourceFiles="@(ShaderSource)" DestinationFolder="$(OutDir)shaders" SkipUnchangedFiles="true" />
  </Target>
